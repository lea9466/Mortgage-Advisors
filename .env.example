# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public address of the site (sign-up confirmation links point here)
SITE_URL=http://localhost:3000

# File storage: supabase | s3 | local
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=case-files

# Only for STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2, Backblaze B2)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only for STORAGE_PROVIDER=local (development)
LOCAL_STORAGE_DIR=.storage
FILE_URL_SIGNING_KEY=

# Field-level encryption keys, 32 random bytes each, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
